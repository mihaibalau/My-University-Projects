<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="Lab1.Properties.Settings.Mountain_bike_racingConnectionString"
            connectionString="Data Source=MIHAI;Initial Catalog=&quot;Mountain bike racing&quot;;Integrated Security=True;TrustServerCertificate=True"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>

		<add key="ParentTableName" value="Bikers"/>
		<add key="ParentPK" value="BikerID" />

		<add key = "ChildTableName" value="Bikes"/>
		<add key = "ChildColumnNames" value="BikeSeries,Model,Value,BikerId"/>
		<add key = "ChildPK" value="BikeSeries" />
		<add key = "ChildFK" value="BikerID" />

		<add key = "ColumnNamesInsertParameters" value ="@BikeSeries,@Model,@Value,@BikerId"/>
		<add key = "DeleteQuery" value="DELETE FROM Bikes WHERE BikeSeries=@BikeSeries" />

		<!--
		<add key="ParentTableName" value="Bikes"/>
		<add key="ParentPK" value="BikeSeries" />

		<add key = "ChildTableName" value="BikeMaintenance"/>
		<add key = "ChildColumnNames" value="MaintenanceId,BikeSeries,MaintenanceDate,Description,Cost"/>
		<add key = "ChildPK" value="MaintenanceId" />
		<add key = "ChildFK" value="BikeSeries" />

		<add key = "ColumnNamesInsertParameters" value ="@MaintenanceId,@BikeSeries,@MaintenanceDate,@Description,@Cost"/>
		<add key="DeleteQuery" value="DELETE FROM BikeMaintenance WHERE MaintenanceId=@MaintenanceId" />
		-->
	</appSettings>
</configuration>